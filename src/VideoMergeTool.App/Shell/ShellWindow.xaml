<Window x:Class="VideoMergeTool.App.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:VideoMergeTool.App.Shell"
        Title="Video Merge Tool"
        Height="680" Width="1180" MinHeight="520" MinWidth="860"
        Background="{DynamicResource WindowBackground}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        AllowDrop="True"
        PreviewDragEnter="Window_PreviewDragOver"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDragLeave="Window_PreviewDragLeave"
        PreviewDrop="Window_PreviewDrop">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{DynamicResource SurfaceBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Margin="16,18,16,10" FontSize="14" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" Text="Video Merge Tool" />

            <ListBox Grid.Row="1" Margin="8,0" BorderThickness="0" Background="Transparent"
                     ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigationItem}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,9" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                            Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSelected}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type shell:NavigationItem}">
                        <TextBlock Text="{Binding Title}" FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Grid.Row="2" Margin="8,10" HorizontalAlignment="Stretch"
                    Style="{StaticResource BaseButton}"
                    Command="{Binding CycleThemeCommand}"
                    ToolTip="Switch between following Windows, always light, and always dark"
                    Content="{Binding ThemeButtonText}" />
        </Grid>

        <!-- Active feature -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentPage}" />

            <!-- Drop target overlay -->
            <Border x:Name="DropOverlay" Visibility="Collapsed"
                    Margin="10" CornerRadius="10"
                    Background="{DynamicResource DropOverlayBackground}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                    IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"
                               Text="Drop the folder to scan it" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}"
                               Text="Dropping a file uses the folder that contains it." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
