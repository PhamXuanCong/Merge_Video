<Application x:Class="VideoMergeTool.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VideoMergeTool.App.Converters"
             xmlns:mergeVideo="clr-namespace:VideoMergeTool.App.Features.MergeVideo"
             xmlns:renameVideo="clr-namespace:VideoMergeTool.App.Features.RenameVideo"
             xmlns:downloadVideo="clr-namespace:VideoMergeTool.App.Features.DownloadVideo"
             xmlns:folderVideoStats="clr-namespace:VideoMergeTool.App.Features.FolderVideoStats">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Index 0 is the palette and ThemeManager replaces it at runtime, so it must
                    stay first. Controls.xaml reads every colour through DynamicResource.
                -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:StatusTextConverter x:Key="StatusText" />

            <!--
                View-model-first navigation: the shell's ContentControl is bound to whichever
                feature view model is active, and WPF picks the matching view via this template.
            -->
            <DataTemplate DataType="{x:Type mergeVideo:MergeVideoViewModel}">
                <mergeVideo:MergeVideoView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type renameVideo:RenameVideoViewModel}">
                <renameVideo:RenameVideoView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type downloadVideo:DownloadVideoViewModel}">
                <downloadVideo:DownloadVideoView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type folderVideoStats:FolderVideoStatsViewModel}">
                <folderVideoStats:FolderVideoStatsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
