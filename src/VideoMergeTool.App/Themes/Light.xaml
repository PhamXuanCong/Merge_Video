<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette keys must match Dark.xaml exactly: the two dictionaries are swapped at runtime. -->

    <SolidColorBrush x:Key="WindowBackground" Color="#F4F5F7" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrushSoft" Color="#DFE1E6" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280" />

    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#EFF4FF" />
    <SolidColorBrush x:Key="AccentSelected" Color="#DBE7FF" />

    <SolidColorBrush x:Key="RowHover" Color="#F5F7FA" />
    <SolidColorBrush x:Key="TrackBackground" Color="#E4E7EC" />

    <SolidColorBrush x:Key="ScrollThumb" Color="#C2C7D0" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#9AA1AC" />
    <SolidColorBrush x:Key="ScrollThumbActive" Color="#7C8593" />

    <SolidColorBrush x:Key="StatusPending" Color="#6B7280" />
    <SolidColorBrush x:Key="StatusRunning" Color="#1D4ED8" />
    <SolidColorBrush x:Key="StatusDone" Color="#15803D" />
    <SolidColorBrush x:Key="StatusSkipped" Color="#B45309" />
    <SolidColorBrush x:Key="StatusFailed" Color="#B91C1C" />

    <SolidColorBrush x:Key="DropOverlayBackground" Color="#F2EFF4FF" />

</ResourceDictionary>
